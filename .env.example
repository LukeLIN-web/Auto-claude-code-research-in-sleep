# Exa Search
EXA_API_KEY=

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# MiniMax Chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=8192

# LLM Chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-sol
# Optional: a DIFFERENT model tried after the primary exhausts retries.
# Leave empty to disable cross-model fallback.
LLM_FALLBACK_MODEL=
LLM_MAX_TOKENS=8192
LLM_SERVER_NAME=llm-chat

# Gemini Review
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_REVIEW_SERVER_NAME=gemini-review
GEMINI_BIN=gemini
GEMINI_REVIEW_MODEL=
GEMINI_REVIEW_SYSTEM=
GEMINI_REVIEW_BACKEND=api
GEMINI_REVIEW_TIMEOUT_SEC=600
GEMINI_REVIEW_API_MODEL=gemini-3-pro-preview
GEMINI_REVIEW_MAX_OUTPUT_TOKENS=65536
GEMINI_REVIEW_DEBUG_LOG=/tmp/gemini-review-mcp-debug.log

# Feishu Bridge
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ID=
BRIDGE_PORT=5000

# Claude Review
CLAUDE_REVIEW_SERVER_NAME=claude-review
CLAUDE_BIN=claude
CLAUDE_REVIEW_MODEL=
# Optional: comma-separated fallback model list passed to `claude --fallback-model`
CLAUDE_REVIEW_FALLBACK_MODEL=
# Optional: hard per-invocation spend cap passed to `claude --max-budget-usd`
CLAUDE_REVIEW_MAX_BUDGET_USD=
CLAUDE_REVIEW_SYSTEM=
CLAUDE_REVIEW_TOOLS=
CLAUDE_REVIEW_TIMEOUT_SEC=600
CLAUDE_REVIEW_DEBUG_LOG=/tmp/claude-review-mcp-debug.log

# Manual Review (human-in-the-loop, zero API cost)
MANUAL_REVIEW_SERVER_NAME=manual-review
MANUAL_REVIEW_TIMEOUT_SEC=86400
MANUAL_REVIEW_MODE=browser
MANUAL_REVIEW_AUTO_OPEN=true
MANUAL_REVIEW_PORT=17900
MANUAL_REVIEW_PENDING_DIR=.aris/pending_review
MANUAL_REVIEW_DEBUG_LOG=
